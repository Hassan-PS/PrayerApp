    <string name="widget_intent_tasbih">Count dhikr</string>
    <!-- The picker blurbs, iOS's own. Android's say "4×2, resizable" because
         that is what a launcher grid is; iOS has families, not cells, and a
         widget that offers to be resized on a phone that cannot resize it is
         worse than a widget that says nothing. Everything else in this file is
         shared between the two platforms. -->
    <string name="widget_ios_description_prayer_times">Today\'s prayer times including Sunrise. After Isha, shows tomorrow.</string>
