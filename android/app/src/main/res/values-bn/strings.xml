    <string name="widget_description">আজকের সময়সূচি এক সারিতে, পরবর্তী নামায হাইলাইট করা থাকে</string>
    <string name="widget_description_small">শুধু পরবর্তী নামায ও তার সময়। 2×1, আকার পরিবর্তনযোগ্য।</string>
    <string name="widget_description_medium">ছয়টি সময়ই একটি প্রশস্ত সারি জুড়ে কলাম আকারে, পরবর্তী নামায হাইলাইট করা। 4×2, আকার পরিবর্তনযোগ্য।</string>
    <string name="widget_description_prayer_times">আজকের ছয়টি সময় এক সারিতে। শহর ও হিজরি তারিখের জন্য এটি উঁচু করুন, চর্চার গ্রাফের জন্য আরও উঁচু করুন। 4×1 থেকে 4×4।</string>
    <string name="widget_description_large_retired">নামাযের সময়ের পুরনো উইজেট। এটি এখন বর্তমান উইজেটের মতোই দেখায়; নতুন করে এটি বসানোর কোনো কারণ নেই।</string>
    <string name="widget_description_large">ছয়টি সময়ই পরবর্তী নামাযের পাশে তালিকা আকারে। 4×3 — তিন সারির নিচে ছোট করলে এটি এক-সারির স্ট্রিপ হয়ে যায়।</string>
    <string name="widget_name_log">Mihrab · আজকের লগ</string>
    <string name="widget_description_log">সময়মতো লগ করতে একটি নামাযে ট্যাপ করুন, সাথে পরবর্তীটির কাউন্টডাউন। চর্চার গ্রাফের জন্য এটি উঁচু করুন। 4×1 থেকে 4×4।</string>
