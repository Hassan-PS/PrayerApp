<?xml version="1.0" encoding="utf-8"?>
<!--
  Continue Reading.

  Where the reader left off on the left; what the khatmah asks of today on
  the right. The right column is `wrap_content` with a fixed minimum so it
  does not collapse when the surah name is long — a portion counter that
  reflows to two digits and back between refreshes is worse than one that
  keeps its own column.

  The progress line is a ProgressBar in horizontal style, which is one of
  the few widgets RemoteViews will accept; a two-view fake bar would need a
  measured width this side cannot know.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_shell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/widget_card_inset">

    <!--
        The card. Inset from the host view so two widgets in adjacent cells
        cannot touch, and rounded so each reads as its own card rather than
        part of one slab. Recoloured at runtime — see `widget_card.xml` for
        why it is an ImageView and not a background.
    -->
    <ImageView
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <TextView
            android:id="@+id/widget_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="#9AA0A6"
            android:textSize="12sp"
            android:visibility="gone" />

            <!--
                Centred, not top-anchored. A widget is only ever exactly as tall
                as its content at one size; at every other size the slack has to
                go somewhere, and pooling it under the last line reads as a card
                that ran out of things to say. Balanced above and below it reads
                as breathing room.
            -->
        <LinearLayout
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:visibility="gone">
            android:gravity="center_vertical"

            <!-- Centred inside the full-height column: this is where the slack
                 actually is, not on the row above it. -->
            <!--
                One block, evenly spaced, centred.

                Three attempts at this. Centring a tight stack left holes above
                and below; bumping the type made a smaller hole; pinning the
                header to the top and the body to the bottom filled the card but
                read as unrelated fragments with the progress bar floating away
                from the position it describes.

                What works is treating the column as one thing and giving it a
                rhythm: a consistent step between every line, so the block is
                tall enough to sit comfortably in the card and close enough to
                read as a single card rather than a scatter. Lines that belong
                together stay adjacent, and the whole is centred.
            -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reading_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:ellipsize="end" />





                <TextView
                    android:id="@+id/reading_surah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#E8EAED"
                    android:textSize="23sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/reading_position"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="#9AA0A6"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end" />



                <ProgressBar
                    android:id="@+id/reading_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/reading_progress_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/reading_tail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
                The one control on this card (issue #25).

                BETWEEN the columns, not inside one of them. It began inside
                the text column on the surah's line, where it read well and
                cost more than it looked: a 40dp control makes the line it
                sits on 40dp tall, and at one cell the card has 69dp for the
                whole stack — so the header, the surah and the page no
                longer fitted and the last of them was cut off. A control
                should not decide how tall a paragraph is.

                Out here it is a sibling of both columns and centred against
                them, so its size bounds the CARD (which is at least 89dp at
                the smallest size it offers) instead of the text. 36dp is
                still a comfortable target for a thumb.
            -->
            <ImageView
                android:id="@+id/reading_play"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="@drawable/widget_play_button"
                android:src="@drawable/ic_widget_play"
                android:visibility="gone" />

            <!-- Centred like the column opposite. Two full-height columns with
                 different gravities read as two widgets pushed together. -->
            <LinearLayout
                android:id="@+id/reading_side"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="96dp"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reading_side_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:maxLines="1" />





                <TextView
                    android:id="@+id/reading_side_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#E8EAED"
                    android:textSize="27sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />



                <TextView
                    android:id="@+id/reading_side_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#9AA0A6"
                    android:textSize="11sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
